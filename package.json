{
  "name": "@rumoro-dev/sdk",
  "version": "0.1.3",
  "description": "TypeScript SDK for the Rumoro API, generated from its OpenAPI document.",
  "license": "MIT",
  "homepage": "https://docs.rumoro.dev/sdks/typescript",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rumoro-dev/sdk.git"
  },
  "bugs": {
    "url": "https://github.com/rumoro-dev/sdk/issues"
  },
  "keywords": [
    "rumoro",
    "social listening",
    "brand monitoring",
    "sdk",
    "api client",
    "openapi"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "export-openapi": "node --experimental-strip-types scripts/export-openapi.mjs",
    "generate": "npm run export-openapi && openapi-ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "prepublishOnly": "npm run typecheck && npm run build && npm test"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.99.0",
    "@types/node": "^22.20.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
